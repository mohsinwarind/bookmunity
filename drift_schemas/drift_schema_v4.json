  "fixed_sql": [
    {
      "name": "books",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"books\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"author\" TEXT NOT NULL DEFAULT 'UNKNOWN', \"cover_path\" TEXT NULL, \"file_path\" TEXT NOT NULL, \"file_hash\" TEXT NOT NULL UNIQUE, \"book_key\" TEXT NOT NULL DEFAULT '', \"shelf\" TEXT NOT NULL DEFAULT 'wantToRead', \"added_at\" INTEGER NOT NULL, \"last_opened_at\" INTEGER NULL, \"last_cfi\" TEXT NULL, \"progress_percent\" REAL NOT NULL DEFAULT 0.0, \"total_locations\" INTEGER NULL, \"is_finished\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_finished\" IN (0, 1)), \"finished_at\" INTEGER NULL, \"genre\" TEXT NULL, \"locations_json\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "highlights",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"highlights\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"book_id\" INTEGER NOT NULL REFERENCES books (id) ON DELETE CASCADE, \"cfi_range\" TEXT NOT NULL, \"selected_text\" TEXT NOT NULL, \"color\" INTEGER NOT NULL DEFAULT 0, \"note\" TEXT NULL, \"chapter_title\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "dictionary_caches",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"dictionary_caches\" (\"word\" TEXT NOT NULL, \"response_json\" TEXT NOT NULL, \"cached_at\" INTEGER NOT NULL, PRIMARY KEY (\"word\"));"
        }
      ]
    },
    {
      "name": "bookmarks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bookmarks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"book_id\" INTEGER NOT NULL REFERENCES books (id) ON DELETE CASCADE, \"cfi\" TEXT NOT NULL, \"label\" TEXT NULL, \"percent\" REAL NOT NULL DEFAULT 0.0, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "reading_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reading_sessions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"book_id\" INTEGER NOT NULL, \"started_at\" INTEGER NOT NULL, \"ended_at\" INTEGER NOT NULL, \"duration_seconds\" INTEGER NOT NULL, \"start_percent\" REAL NOT NULL DEFAULT 0.0, \"end_percent\" REAL NOT NULL DEFAULT 0.0);"
        }
      ]
    },
    {
      "name": "badge_unlocks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"badge_unlocks\" (\"badge_id\" TEXT NOT NULL, \"unlocked_at\" INTEGER NOT NULL, PRIMARY KEY (\"badge_id\"));"
        }
      ]
    }
  ]
